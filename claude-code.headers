# Claude Code request headers (template): https://github.com/rays1d/pi-custom-header/blob/main/templates/claude-code.headers
#
# Source: real capture references/claude-code-header.txt
# Dynamic lines use {{placeholders}}; static lines are verbatim.
# Blacklisted headers (Authorization / Content-Length / Host / Connection /
# Accept-Encoding) are intentionally omitted — pi and the HTTP layer own them.
Accept: application/json
Content-Type: application/json
User-Agent: claude-cli/2.1.224 (external, cli)
X-Claude-Code-Session-Id: {{session_id}}
X-Stainless-Arch: x64
X-Stainless-Lang: js
X-Stainless-OS: Windows
X-Stainless-Package-Version: 0.94.0
X-Stainless-Retry-Count: 0
X-Stainless-Runtime: node
X-Stainless-Runtime-Version: v26.3.0
X-Stainless-Timeout: 600
