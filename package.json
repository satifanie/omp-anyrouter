{
  "name": "omp-anyrouter",
  "version": "1.1.2",
  "private": false,
  "type": "module",
  "description": "oh-my-pi extension that proxies models through AnyRouter-style relays by emulating native Claude Code / Codex CLI requests",
  "keywords": [
    "oh-my-pi",
    "omp",
    "omp-extension",
    "anyrouter",
    "claude",
    "codex"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "README.md",
    "anyrouter.example.json"
  ],
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "undici": "^8.3.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "17.2.11",
    "@oh-my-pi/pi-coding-agent": "17.2.11",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  }
}
